<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Directly serve existing physical files and directories (images, uploads, css, js, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Proxy API and health requests to backend if running on local port 8789
  <IfModule mod_proxy.c>
    RewriteRule ^api/(.*)$ http://127.0.0.1:8789/api/$1 [P,L]
    RewriteRule ^health(.*)$ http://127.0.0.1:8789/health$1 [P,L]
  </IfModule>

  # 3. Do not rewrite missing static assets to index.html (prevents 422 / MIME mismatch)
  RewriteCond %{REQUEST_URI} \.(png|jpe?g|gif|svg|webp|ico|css|js|map|woff2?|ttf|eot|pdf)$ [NC]
  RewriteRule ^ - [R=404,L]

  # 4. SPA fallback for client-side routing (send all other frontend routes to index.html)
  RewriteRule ^ index.html [L]
</IfModule>
